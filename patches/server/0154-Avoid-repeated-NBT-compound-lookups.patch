                 return new NBTTagList();
             } else {
-                NBTTagList nbttaglist = (NBTTagList) this.map.get(s);
+                NBTTagList nbttaglist = (NBTTagList) value;
 
                 return nbttaglist.size() > 0 && nbttaglist.f() != i ? new NBTTagList() : nbttaglist;
             }
diff --git a/src/test/java/net/minecraft/server/NBTTagCompoundReadTest.java b/src/test/java/net/minecraft/server/NBTTagCompoundReadTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..caadc01d1496fff62fee5a568924a4cebba1071f
--- /dev/null
+++ b/src/test/java/net/minecraft/server/NBTTagCompoundReadTest.java
@@ -0,0 +1,65 @@
+package net.minecraft.server;
+
+import org.junit.Test;
+
+import static org.junit.Assert.*;
+
+public class NBTTagCompoundReadTest {
+    @Test
+    public void numericReadsPreserveAllConversionsAndDefaults() {
+        NBTBase.NBTNumber[] numbers = {
+                new NBTTagByte((byte) -3), new NBTTagShort((short) 258), new NBTTagInt(65537),
+                new NBTTagLong(Long.MAX_VALUE), new NBTTagFloat(-2.75F), new NBTTagDouble(258.75D)
+        };
+        NBTTagCompound tag = new NBTTagCompound();
+        for (NBTBase.NBTNumber number : numbers) {
+            tag.set("value", number);
+            assertEquals(number.f(), tag.getByte("value"));
+            assertEquals(number.e(), tag.getShort("value"));
+            assertEquals(number.d(), tag.getInt("value"));
+            assertEquals(number.c(), tag.getLong("value"));
+            assertEquals(number.h(), tag.getFloat("value"), 0F);
+            assertEquals(number.g(), tag.getDouble("value"), 0D);
+            assertEquals(number.f() != 0, tag.getBoolean("value"));
+        }
+        tag.setString("wrong", "text");
+        for (String key : new String[]{"missing", "wrong"}) {
+            assertEquals(0, tag.getByte(key));
+            assertEquals(0, tag.getShort(key));
+            assertEquals(0, tag.getInt(key));
+            assertEquals(0L, tag.getLong(key));
+            assertEquals(0F, tag.getFloat(key), 0F);
+            assertEquals(0D, tag.getDouble(key), 0D);
+            assertFalse(tag.getBoolean(key));
+        }
+    }
+
+    @Test
+    public void structuredReadsPreserveReferencesAndListTypeChecks() {
+        NBTTagCompound tag = new NBTTagCompound();
+        byte[] bytes = {1, 2};
+        int[] integers = {3, 4};
+        NBTTagCompound child = new NBTTagCompound();
+        NBTTagList list = new NBTTagList();
+        list.add(new NBTTagString("value"));
+        tag.setByteArray("bytes", bytes);
+        tag.setIntArray("integers", integers);
+        tag.set("child", child);
+        tag.set("list", list);
+        tag.setString("text", "value");
+        assertSame(bytes, tag.getByteArray("bytes"));
+        assertSame(integers, tag.getIntArray("integers"));
+        assertSame(child, tag.getCompound("child"));
+        assertSame(list, tag.getList("list", 8));
+        assertEquals(0, tag.getList("list", 3).size());
+        assertEquals("value", tag.getString("text"));
+        for (String key : new String[]{"missing", "text"}) {
+            assertEquals(0, tag.getByteArray(key).length);
+            assertEquals(0, tag.getIntArray(key).length);
+            assertTrue(tag.getCompound(key).isEmpty());
+            assertEquals(0, tag.getList(key, 8).size());
+        }
+        assertEquals("", tag.getString("child"));
+        assertEquals("", tag.getString("missing"));
+    }
+}
