+package net.minecraft.server;
+
+import com.hpfxd.pandaspigot.TickWorkBudget;
+import com.hpfxd.pandaspigot.config.PandaSpigotConfig;
+
+import java.util.Iterator;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.UUID;
+
+public final class PlayerChunkSendQueue {
+    private final Map<UUID, EntityPlayer> pending = new LinkedHashMap<>();
+    private final TickWorkBudget budget = new TickWorkBudget();
+
+    public void add(EntityPlayer player) {
+        this.pending.put(player.getUniqueID(), player);
+    }
+
+    public void tick(MinecraftServer server) {
+        PandaSpigotConfig config = PandaSpigotConfig.get();
+        this.budget.reset(config.chunkSendMaxChunksPerTick, (long) (config.chunkSendMaxMillisPerTick * 1_000_000L));
+        int turns = this.pending.size();
+        while (turns-- > 0 && this.budget.hasRemaining()) {
+            Iterator<EntityPlayer> iterator = this.pending.values().iterator();
+            EntityPlayer player = iterator.next();
+            iterator.remove();
+            if (server.getPlayerList().a(player.getUniqueID()) != player || player.playerConnection == null
+                || !player.playerConnection.networkManager.g() || player.chunkCoordIntPairQueue.isEmpty()) continue;
+            long started = System.nanoTime();
+            int sent = 0;
+            try {
+                sent = player.sendQueuedChunks(this.budget.remaining());
+            } finally {
+                this.budget.record(sent, started);
+            }
+            if (!player.chunkCoordIntPairQueue.isEmpty()) this.pending.put(player.getUniqueID(), player);
+        }
+    }
+}
