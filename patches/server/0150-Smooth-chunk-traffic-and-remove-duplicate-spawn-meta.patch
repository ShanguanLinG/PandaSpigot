@@ -0,0 +1,25 @@
+package com.hpfxd.pandaspigot;
+
+public final class ChunkSendBudget {
+    private int limit;
+    private int sent;
+
+    public void reset(int limit) {
+        this.sent = Math.max(0, this.sent - this.limit);
+        this.limit = limit;
+    }
+
+    public boolean hasRemaining() {
+        return this.sent < this.limit;
+    }
+
+    public boolean acquire(int bytes) {
+        return this.acquire(bytes, false);
+    }
+
+    public boolean acquire(int bytes, boolean immediate) {
+        if (!immediate && this.sent > 0 && bytes > this.limit - this.sent) return false;
+        this.sent += bytes;
+        return true;
+    }
+}
