From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ShanguanLinG <bilibiliShanguanLinG@outlook.com>
Date: Tue, 13 Oct 2026 19:02:28 +0800
Subject: [PATCH] Reduce item NBT encoding allocations


diff --git a/src/main/java/net/minecraft/server/NBTTagCompound.java b/src/main/java/net/minecraft/server/NBTTagCompound.java
index 1baf396f1c1bc369f778e1b3aa83e3eecaad4bd3..b6da9ecdbdfba215366273831cec7acf7611239c 100644
--- a/src/main/java/net/minecraft/server/NBTTagCompound.java
+++ b/src/main/java/net/minecraft/server/NBTTagCompound.java
@@ -285,9 +285,11 @@ public class NBTTagCompound extends NBTBase {
     public NBTBase clone() {
         NBTTagCompound nbttagcompound = new NBTTagCompound();
 
-        for (String s : this.map.keySet()) {
-            nbttagcompound.set(s, ((NBTBase) this.map.get(s)).clone());
+        // PandaSpigot start
+        for (Map.Entry<String, NBTBase> entry : this.map.entrySet()) {
+            nbttagcompound.set(entry.getKey(), entry.getValue().clone());
         }
+        // PandaSpigot end
 
         return nbttagcompound;
     }
diff --git a/src/main/java/net/minecraft/server/NBTTagList.java b/src/main/java/net/minecraft/server/NBTTagList.java
index a0e6b0ff520dafc53a0b9f180153997b127bc3e0..6f483646acfa9e05c64e1f1e02e226a6b99edb2c 100644
--- a/src/main/java/net/minecraft/server/NBTTagList.java
+++ b/src/main/java/net/minecraft/server/NBTTagList.java
@@ -179,6 +179,7 @@ public class NBTTagList extends NBTBase {
         NBTTagList nbttaglist = new NBTTagList();
 
         nbttaglist.type = this.type;
+        nbttaglist.list = Lists.newArrayListWithCapacity(this.list.size()); // PandaSpigot
         Iterator iterator = this.list.iterator();
 
         while (iterator.hasNext()) {
diff --git a/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaItem.java b/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaItem.java
index eaaa6a11a57dcf7b8f6a18eed6c722febea39d17..dc1e91322392f8b8a18884ebea4af6b2253d9392 100644
--- a/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaItem.java
+++ b/src/main/java/org/bukkit/craftbukkit/inventory/CraftMetaItem.java
@@ -892,8 +892,10 @@ class CraftMetaItem implements ItemMeta, Repairable {
             }
             try {
                 ByteArrayOutputStream buf = new ByteArrayOutputStream();
-                NBTCompressedStreamTools.a(internal, buf);
-                builder.put("internal", Base64.encodeBase64String(buf.toByteArray()));
+                // PandaSpigot start
+                NBTCompressedStreamTools.a(internal, java.util.Base64.getEncoder().wrap(buf));
+                builder.put("internal", buf.toString("US-ASCII"));
+                // PandaSpigot end
             } catch (IOException ex) {
                 Logger.getLogger(CraftMetaItem.class.getName()).log(Level.SEVERE, null, ex);
             }
diff --git a/src/test/java/org/bukkit/craftbukkit/inventory/ItemMetaEncodingTest.java b/src/test/java/org/bukkit/craftbukkit/inventory/ItemMetaEncodingTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..08d747da045bd0c5d9e563b162ea4a2a425804ca
--- /dev/null
+++ b/src/test/java/org/bukkit/craftbukkit/inventory/ItemMetaEncodingTest.java
@@ -0,0 +1,41 @@
+package org.bukkit.craftbukkit.inventory;
+
+import net.minecraft.server.*;
+import org.apache.commons.codec.binary.Base64;
+import org.bukkit.Material;
+import org.bukkit.inventory.ItemStack;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+
+import java.io.ByteArrayOutputStream;
+import java.util.Map;
+
+import static org.junit.Assert.*;
+
+public class ItemMetaEncodingTest extends AbstractTestingBase {
+    @Test
+    public void internalTagsKeepTheExistingCompressedBase64Format() throws Exception {
+        NBTTagCompound tags = new NBTTagCompound();
+        NBTTagCompound nested = new NBTTagCompound();
+        nested.setByteArray("bytes", new byte[131072]);
+        nested.setString("state", "\u6d4b\u8bd5\u0000\ud83d\ude00");
+        NBTTagList list = new NBTTagList();
+        for (int index = 0; index < 100; index++) list.add(new NBTTagInt(index));
+        nested.set("list", list);
+        tags.set("custom", nested);
+        net.minecraft.server.ItemStack handle = CraftItemStack.asNMSCopy(new ItemStack(Material.DIAMOND_SWORD));
+        handle.setTag(tags);
+        Map<String, Object> serialized = CraftItemStack.asCraftMirror(handle).getItemMeta().serialize();
+        ByteArrayOutputStream compressed = new ByteArrayOutputStream();
+        NBTCompressedStreamTools.a(tags, compressed);
+        assertEquals(Base64.encodeBase64String(compressed.toByteArray()), serialized.get("internal"));
+        assertEquals(tags, NBTCompressedStreamTools.a(new java.io.ByteArrayInputStream(
+                Base64.decodeBase64((String) serialized.get("internal")))));
+        NBTTagCompound clone = (NBTTagCompound) tags.clone();
+        assertEquals(tags, clone);
+        clone.getCompound("custom").getByteArray("bytes")[0] = 1;
+        clone.getCompound("custom").getList("list", 3).a(0, new NBTTagInt(200));
+        assertEquals(0, tags.getCompound("custom").getByteArray("bytes")[0]);
+        assertNotEquals(tags, clone);
+    }
+}
