+package com.hpfxd.pandaspigot;
+
+import org.junit.Test;
+
+import static org.junit.Assert.*;
+
+public class ChunkSendBudgetTest {
+    @Test
+    public void sharedBudgetRejectsOversizedNextChunkWithoutSpendingItsCredit() {
+        ChunkSendBudget budget = new ChunkSendBudget();
+        budget.reset(100);
+        assertTrue(budget.acquire(60));
+        assertFalse(budget.acquire(50));
+        assertTrue(budget.acquire(40));
+        assertFalse(budget.hasRemaining());
+    }
+
+    @Test
+    public void firstOversizedChunkMakesProgressAndStopsFurtherSendingUntilNextTick() {
+        ChunkSendBudget budget = new ChunkSendBudget();
+        budget.reset(100);
+        assertTrue(budget.acquire(150));
+        assertFalse(budget.hasRemaining());
+        assertFalse(budget.acquire(1));
+        budget.reset(100);
+        assertFalse(budget.acquire(100));
+        assertTrue(budget.acquire(50));
+        budget.reset(100);
+        assertTrue(budget.acquire(100));
+    }
+
+    @Test
+    public void nearbyBatchBorrowsFutureAllowanceAndPausesOuterChunksUntilRepaid() {
+        ChunkSendBudget budget = new ChunkSendBudget();
+        budget.reset(100);
+        assertTrue(budget.acquire(100, true));
+        assertTrue(budget.acquire(150, true));
+        assertFalse(budget.hasRemaining());
+        assertFalse(budget.acquire(1));
+        budget.reset(100);
+        assertFalse(budget.hasRemaining());
+        assertFalse(budget.acquire(1));
+        budget.reset(100);
+        assertTrue(budget.hasRemaining());
+        assertFalse(budget.acquire(51));
+        assertTrue(budget.acquire(50));
+        assertFalse(budget.hasRemaining());
+        budget.reset(100);
+        assertTrue(budget.acquire(100));
+    }
+}
