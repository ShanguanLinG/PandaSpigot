Date: Thu, 29 Oct 2026 14:02:14 +0800
Subject: [PATCH] fix: align tick end events with Spark sampling


diff --git a/src/main/java/net/minecraft/server/MinecraftServer.java b/src/main/java/net/minecraft/server/MinecraftServer.java
index be1dcb1b93c06297f23bc437c59c514f2c273321..21fd000b57755ae6bf5142b7a4cc96115efecddc 100644
--- a/src/main/java/net/minecraft/server/MinecraftServer.java
+++ b/src/main/java/net/minecraft/server/MinecraftServer.java
@@ -871,19 +871,23 @@ public abstract class MinecraftServer extends IAsyncTaskHandlerReentrant<TickTas
 
         this.methodProfiler.b();
         this.methodProfiler.b();
-        this.mayHaveDelayedTasks = true;
-        this.delayedTasksMaxNextTickTime = Math.max(getNanoTime() + NANOSECONDS_PER_TICK, this.ab);
-        this.waitUntilNextTick();
-        org.spigotmc.WatchdogThread.tick(); // Spigot
         this.finishTick(i);
     }
 
     protected void finishTick(long start) {
-        // PandaSpigot start - Add ServerTickEndEvent
-        long endTime = getNanoTime();
-        long duration = endTime - start - this.tickIdleNanos;
-        this.h[this.ticks % 100] = duration;
-        new com.destroystokyo.paper.event.server.ServerTickEndEvent(this.ticks, duration / 1000000D, this.ab - endTime).callEvent();
+        // PandaSpigot start - Report the contiguous work interval before idle parking.
+        // Spark infers the sample window from the event time minus this duration.
+        long workEnd = getNanoTime();
+        this.mayHaveDelayedTasks = true;
+        this.delayedTasksMaxNextTickTime = Math.max(workEnd + NANOSECONDS_PER_TICK, this.ab);
+        new com.destroystokyo.paper.event.server.ServerTickEndEvent(this.ticks,
+                (workEnd - start) / 1000000D, this.ab - workEnd).callEvent();
+        // PandaSpigot end
+
+        this.waitUntilNextTick();
+        org.spigotmc.WatchdogThread.tick(); // Spigot
+        // PandaSpigot start - Retain queued work in full-tick accounting without idle time.
+        this.h[this.ticks % 100] = getNanoTime() - start - this.tickIdleNanos;
         // PandaSpigot end
         co.aikar.timings.TimingsManager.FULL_SERVER_TICK.stopTiming(this.tickIdleNanos); // Spigot
     }
