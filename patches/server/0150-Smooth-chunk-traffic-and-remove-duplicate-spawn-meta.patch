+    @Test
+    public void queuedBytesPauseChunksBeforeHighWaterMarkWithoutBlockingCombat() throws Exception {
+        Field config = PandaSpigotConfig.class.getDeclaredField("config");
+        config.setAccessible(true);
+        Object previous = config.get(null);
+        EmbeddedChannel channel = new EmbeddedChannel();
+        try {
+            config.set(null, new PandaSpigotConfig());
+            channel.config().setWriteBufferWaterMark(new WriteBufferWaterMark(512 * 1024, 1024 * 1024));
+            NetworkManager network = new NetworkManager(EnumProtocolDirection.SERVERBOUND);
+            network.channel = (Channel) Proxy.newProxyInstance(Channel.class.getClassLoader(), new Class<?>[]{Channel.class},
+                    (proxy, method, args) -> method.getName().equals("bytesBeforeUnwritable")
+                            ? channel.bytesBeforeWritable() : method.invoke(channel, args));
+            channel.attr(NetworkManager.c).set(EnumProtocol.PLAY);
+            assertEquals(0, network.channel.bytesBeforeUnwritable());
+            assertTrue(network.canSendChunks(65536));
+            ByteBuf queued = Unpooled.buffer(65536).writeZero(65536);
+            channel.write(queued);
+            assertTrue(channel.isWritable());
+            assertFalse(network.canSendChunks(65536));
+            PacketPlayOutEntityVelocity combat = new PacketPlayOutEntityVelocity(42, 0.1, 0.2, 0.3);
+            network.handle(combat);
+            assertSame(queued, channel.readOutbound());
+            queued.release();
+            assertSame(combat, channel.readOutbound());
+            assertTrue(network.canSendChunks(65536));
+        } finally {
+            channel.finishAndReleaseAll();
+            config.set(null, previous);
+        }
+    }
