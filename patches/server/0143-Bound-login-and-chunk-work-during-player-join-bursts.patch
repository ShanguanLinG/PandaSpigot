@@ -0,0 +1,22 @@
+package com.hpfxd.pandaspigot;
+
+import org.junit.Test;
+
+import static org.junit.Assert.*;
+
+public class TickWorkBudgetTest {
+    @Test
+    public void sharesCountAndElapsedWorkAcrossCallsAndResetsForTheNextTick() {
+        TickWorkBudget budget = new TickWorkBudget();
+        budget.reset(2, Long.MAX_VALUE);
+        budget.record(1, System.nanoTime());
+        assertTrue(budget.hasRemaining());
+        assertEquals(1, budget.remaining());
+        budget.record(1, System.nanoTime());
+        assertFalse(budget.hasRemaining());
+        budget.reset(4, 0L);
+        assertTrue(budget.hasRemaining());
+        budget.record(1, System.nanoTime() - 1L);
+        assertFalse(budget.hasRemaining());
+    }
+}
diff --git a/src/test/java/org/bukkit/craftbukkit/util/AsynchronousExecutorBudgetTest.java b/src/test/java/org/bukkit/craftbukkit/util/AsynchronousExecutorBudgetTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..d7bff924b4eb08e740f969f007a10920a599c312
--- /dev/null
+++ b/src/test/java/org/bukkit/craftbukkit/util/AsynchronousExecutorBudgetTest.java
@@ -0,0 +1,120 @@
+package org.bukkit.craftbukkit.util;
+
+import com.hpfxd.pandaspigot.TickWorkBudget;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+
+import org.junit.Test;
+
+import static org.junit.Assert.*;
+
+public class AsynchronousExecutorBudgetTest {
+    @Test
+    public void limitsCompletionsWithoutChangingImmediateGetsOrReplayingCallbacks() throws Exception {
+        List<Integer> completed = new ArrayList<>();
+        AsynchronousExecutor<Integer, Integer, Runnable, RuntimeException> executor = executor();
+        try {
+            executor.add(1, () -> completed.add(1));
+            executor.add(2, () -> completed.add(2));
+            executor.add(3, () -> completed.add(3));
+            awaitFinished(executor, 3);
+            TickWorkBudget budget = new TickWorkBudget();
+            budget.reset(1, Long.MAX_VALUE);
+            executor.finishActive(budget);
+            assertEquals(Arrays.asList(1), completed);
+            assertEquals(Integer.valueOf(3), executor.getSkipQueue(3));
+            assertEquals(Arrays.asList(1, 3), completed);
+            budget.reset(4, Long.MAX_VALUE);
+            executor.finishActive(budget);
+            assertEquals(Arrays.asList(1, 3, 2), completed);
+            assertTrue(executor.tasks.isEmpty());
+        } finally {
+            executor.pool.shutdownNow();
+        }
+    }
+
+    @Test
+    public void droppedCallbacksRemainDroppedWhileOtherCompletionsWaitForBudget() throws Exception {
+        List<Integer> completed = new ArrayList<>();
+        AsynchronousExecutor<Integer, Integer, Runnable, RuntimeException> executor = executor();
+        try {
+            Runnable dropped = () -> completed.add(1);
+            executor.add(1, dropped);
+            executor.add(2, () -> completed.add(2));
+            awaitFinished(executor, 2);
+            executor.drop(1, dropped);
+            TickWorkBudget budget = new TickWorkBudget();
+            budget.reset(4, 1L);
+            executor.finishActive(budget);
+            assertTrue(completed.isEmpty());
+            budget.reset(4, Long.MAX_VALUE);
+            executor.finishActive(budget);
+            assertEquals(Arrays.asList(2), completed);
+            assertTrue(executor.tasks.isEmpty());
+        } finally {
+            executor.pool.shutdownNow();
+        }
+    }
+
+    @Test
+    public void callbackFailureConsumesItsBudgetAndDoesNotReplayTheFailedTask() throws Exception {
+        List<Integer> completed = new ArrayList<>();
+        AsynchronousExecutor<Integer, Integer, Runnable, RuntimeException> executor = executor();
+        RuntimeException failure = new RuntimeException("callback");
+        try {
+            executor.add(1, () -> {
+                throw failure;
+            });
+            executor.add(2, () -> completed.add(2));
+            awaitFinished(executor, 2);
+            TickWorkBudget budget = new TickWorkBudget();
+            budget.reset(1, Long.MAX_VALUE);
+            try {
+                executor.finishActive(budget);
+                fail("Callback failure must propagate");
+            } catch (RuntimeException actual) {
+                assertSame(failure, actual);
+            }
+            assertFalse(budget.hasRemaining());
+            assertFalse(executor.tasks.containsKey(1));
+            budget.reset(1, Long.MAX_VALUE);
+            executor.finishActive(budget);
+            assertEquals(Arrays.asList(2), completed);
+            assertTrue(executor.tasks.isEmpty());
+        } finally {
+            executor.pool.shutdownNow();
+        }
+    }
+
+    private static AsynchronousExecutor<Integer, Integer, Runnable, RuntimeException> executor() {
+        return new AsynchronousExecutor<>(new AsynchronousExecutor.CallBackProvider<Integer, Integer, Runnable, RuntimeException>() {
+            @Override
+            public Integer callStage1(Integer parameter) {
+                return parameter;
+            }
+
+            @Override
+            public void callStage2(Integer parameter, Integer object) {
+            }
+
+            @Override
+            public void callStage3(Integer parameter, Integer object, Runnable callback) {
+                callback.run();
+            }
+
+            @Override
+            public Thread newThread(Runnable task) {
+                return new Thread(task);
+            }
+        }, 1);
+    }
+
+    private static void awaitFinished(AsynchronousExecutor<?, ?, ?, ?> executor, int count) throws InterruptedException {
+        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5);
+        while (executor.finished.size() < count && System.nanoTime() < deadline) Thread.sleep(1);
+        assertEquals(count, executor.finished.size());
+    }
+}
