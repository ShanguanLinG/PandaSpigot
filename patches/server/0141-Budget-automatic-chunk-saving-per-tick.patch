         this.methodProfiler.a("tallying");
         this.h[this.ticks % 100] = System.nanoTime() - i;
         this.methodProfiler.b();
@@ -866,6 +878,26 @@ public abstract class MinecraftServer extends IAsyncTaskHandlerReentrant<TickTas
         co.aikar.timings.TimingsManager.FULL_SERVER_TICK.stopTiming(); // Spigot
     }
 
+    // PandaSpigot start - Tick-budgeted automatic saving
+    private void saveAutomaticChunks() {
+        com.hpfxd.pandaspigot.config.PandaSpigotConfig config = com.hpfxd.pandaspigot.config.PandaSpigotConfig.get();
+        long start = System.nanoTime();
+        int processed = 0;
+        int idleWorlds = 0;
+        while (processed < config.autoSaveMaxChunksPerTick && idleWorlds < this.worlds.size()
+                && System.nanoTime() - start < config.autoSaveMaxMillisPerTick * 1000000.0) {
+            if (this.automaticSaveWorldIndex >= this.worlds.size()) this.automaticSaveWorldIndex = 0;
+            WorldServer world = this.worlds.get(this.automaticSaveWorldIndex++);
+            if (world.chunkProviderServer.saveNextAutomaticChunk()) {
+                processed++;
+                idleWorlds = 0;
+            } else {
+                idleWorlds++;
+            }
+        }
+    }
+    // PandaSpigot end
+
     public void B() {
         SpigotTimings.minecraftSchedulerTimer.startTiming(); // Spigot
         this.methodProfiler.a("jobs");
