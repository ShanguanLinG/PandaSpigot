--- /dev/null
+++ b/src/main/java/com/hpfxd/pandaspigot/TickWorkBudget.java
@@ -0,0 +1,28 @@
+package com.hpfxd.pandaspigot;
+
+public final class TickWorkBudget {
+    private int limit;
+    private int completed;
+    private long budgetNanos;
+    private long elapsedNanos;
+
+    public void reset(int limit, long budgetNanos) {
+        this.limit = limit;
+        this.budgetNanos = Math.max(1L, budgetNanos);
+        this.completed = 0;
+        this.elapsedNanos = 0;
+    }
+
+    public boolean hasRemaining() {
+        return this.completed < this.limit && this.elapsedNanos < this.budgetNanos;
+    }
+
+    public int remaining() {
+        return this.limit - this.completed;
+    }
+
+    public void record(int completed, long startedNanos) {
+        this.completed += completed;
+        this.elapsedNanos += System.nanoTime() - startedNanos;
+    }
+}
