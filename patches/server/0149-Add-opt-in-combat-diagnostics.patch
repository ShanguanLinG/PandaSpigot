@@ -0,0 +1,134 @@
+package com.hpfxd.pandaspigot.diagnostics;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.function.Consumer;
+
+import net.minecraft.server.Entity;
+import net.minecraft.server.EntityLiving;
+import net.minecraft.server.DamageSource;
+import net.minecraft.server.ItemStack;
+import net.minecraft.server.NBTTagCompound;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+
+import static org.junit.Assert.*;
+
+public class CombatTraceTest extends AbstractTestingBase {
+    @Test
+    public void sinkShouldFilterActorsAndNeverChangeEntityState() {
+        FixtureEntity watched = new FixtureEntity();
+        FixtureEntity other = new FixtureEntity();
+        watched.motX = 0.75;
+        List<Map<String, Object>> records = new ArrayList<>();
+        Consumer<Map<String, Object>> sink = records::add;
+        CombatTrace.install(Collections.singleton(watched.getUniqueID()), sink, packet -> 11);
+        try {
+            CombatTrace.log(other, null, "unselected");
+            CombatTrace.log(watched, other, "selected", "reason", "fixture");
+            assertEquals(1, records.size());
+            assertEquals("selected", records.get(0).get("stage"));
+            assertEquals("fixture", records.get(0).get("reason"));
+            assertEquals(0.75, watched.motX, 0);
+            assertFalse(watched.dead);
+            CombatTrace.uninstall(record -> {
+            });
+            assertTrue(CombatTrace.enabled());
+        } finally {
+            CombatTrace.uninstall(sink);
+        }
+        assertFalse(CombatTrace.enabled());
+        assertEquals(0, CombatTrace.currentPacketId());
+    }
+
+    @Test
+    public void failingSinkShouldDisableCaptureWithoutBreakingCaller() {
+        FixtureEntity watched = new FixtureEntity();
+        Consumer<Map<String, Object>> sink = record -> {
+            throw new IllegalStateException("fixture capture failure");
+        };
+        CombatTrace.install(Collections.singleton(watched.getUniqueID()), sink, packet -> 11);
+        try {
+            CombatTrace.log(watched, null, "fixture");
+            assertFalse(CombatTrace.enabled());
+            assertFalse(watched.dead);
+        } finally {
+            CombatTrace.uninstall(sink);
+        }
+    }
+
+    @Test
+    public void nestedDamageShouldRestoreContextWhenOriginalCallThrows() {
+        FixtureLiving watched = new FixtureLiving();
+        List<Map<String, Object>> records = new ArrayList<>();
+        Consumer<Map<String, Object>> sink = records::add;
+        java.util.concurrent.atomic.AtomicLong ids = new java.util.concurrent.atomic.AtomicLong();
+        CombatTrace.install(Collections.singleton(watched.getUniqueID()), sink, object -> ids.incrementAndGet());
+        try {
+            try (CombatTrace.Scope outer = CombatTrace.damage(watched, DamageSource.GENERIC, 1, EntityLiving.class)) {
+                long parent = CombatTrace.currentDamageId();
+                assertTrue(parent > 0);
+                try {
+                    try (CombatTrace.Scope inner = CombatTrace.damage(watched, DamageSource.GENERIC, 2, EntityLiving.class)) {
+                        assertNotEquals(parent, CombatTrace.currentDamageId());
+                        throw new IllegalStateException("original combat failure");
+                    }
+                } catch (IllegalStateException expected) {
+                    assertEquals("original combat failure", expected.getMessage());
+                }
+                assertEquals(parent, CombatTrace.currentDamageId());
+                assertEquals(parent, ((Number) records.get(1).get("parentDamageId")).longValue());
+            }
+            assertEquals(0, CombatTrace.currentDamageId());
+            assertEquals("damage.call.exit", records.get(records.size() - 1).get("stage"));
+        } finally {
+            CombatTrace.uninstall(sink);
+        }
+    }
+
+    private static final class FixtureLiving extends EntityLiving {
+        FixtureLiving() {
+            super(null);
+        }
+
+        @Override
+        public ItemStack bA() {
+            return null;
+        }
+
+        @Override
+        public ItemStack getEquipment(int slot) {
+            return null;
+        }
+
+        @Override
+        public void setEquipment(int slot, ItemStack item) {
+        }
+
+        @Override
+        public ItemStack[] getEquipment() {
+            return new ItemStack[5];
+        }
+    }
+
+    private static final class FixtureEntity extends Entity {
+        FixtureEntity() {
+            super(null);
+        }
+
+        @Override
+        protected void h() {
+        }
+
+        @Override
+        protected void a(NBTTagCompound tag) {
+        }
+
+        @Override
+        protected void b(NBTTagCompound tag) {
+        }
+    }
+}
