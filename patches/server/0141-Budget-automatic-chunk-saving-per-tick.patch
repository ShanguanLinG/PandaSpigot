+    // PandaSpigot start - Tick-budgeted automatic saving
+    public void startAutomaticSave() {
+        this.automaticSaveRequested = true;
+    }
+
+    public boolean saveNextAutomaticChunk() {
+        if (this.world.pandaSpigotConfig.disableChunkSaving) {
+            this.automaticSaveChunks = null;
+            this.automaticSaveIndex = 0;
+            this.automaticSaveRequested = false;
+            return false;
+        }
+        if (this.automaticSaveChunks == null) {
+            if (!this.automaticSaveRequested) return false;
+            this.automaticSaveRequested = false;
+            this.automaticSaveChunks = this.chunks.values().toArray(new Chunk[this.chunks.size()]);
+            this.automaticSaveIndex = 0;
+        }
+        if (this.automaticSaveIndex == this.automaticSaveChunks.length) {
+            this.automaticSaveChunks = null;
+            return false;
+        }
+        Chunk chunk = this.automaticSaveChunks[this.automaticSaveIndex++];
+        if (this.getChunkIfLoaded(chunk.locX, chunk.locZ) == chunk && chunk.a(false)) {
+            this.saveChunk(chunk);
+            chunk.f(false);
+        }
+        if (this.automaticSaveIndex == this.automaticSaveChunks.length) this.automaticSaveChunks = null;
+        return true;
+    }
+    // PandaSpigot end
+
