         this.c = itemstack == null ? null : itemstack.cloneItemStack();
     }
 
+    // PandaSpigot start
+    public PacketPlayOutEntityEquipment copy() {
+        return new PacketPlayOutEntityEquipment(this.a, this.b, this.c);
