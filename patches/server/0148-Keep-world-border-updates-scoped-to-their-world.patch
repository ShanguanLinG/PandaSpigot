diff --git a/src/test/java/net/minecraft/server/WorldBorderBroadcastTest.java b/src/test/java/net/minecraft/server/WorldBorderBroadcastTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..b48bda2e9a6ae1cd93450d2a9756dff7bf13c39f
--- /dev/null
+++ b/src/test/java/net/minecraft/server/WorldBorderBroadcastTest.java
@@ -0,0 +1,65 @@
+package net.minecraft.server;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Proxy;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertSame;
+
+public class WorldBorderBroadcastTest extends AbstractTestingBase {
+    @Test
+    public void mainWorldBorderChangesDoNotBroadcastToOtherWorlds() throws Exception {
+        IPlayerFileData storage = (IPlayerFileData) Proxy.newProxyInstance(
+                IPlayerFileData.class.getClassLoader(), new Class<?>[]{IPlayerFileData.class},
+                (proxy, method, args) -> { throw new AssertionError(method); });
+        IDataManager dataManager = (IDataManager) Proxy.newProxyInstance(
+                IDataManager.class.getClassLoader(), new Class<?>[]{IDataManager.class},
+                (proxy, method, args) -> {
+                    if (method.getName().equals("getPlayerFileData")) return storage;
+                    throw new AssertionError(method);
+                });
+        WorldBorder border = new WorldBorder();
+        WorldServer mainWorld = allocate(WorldServer.class);
+        setWorldField(mainWorld, "dataManager", dataManager);
+        setWorldField(mainWorld, "N", border);
+        RecordingPlayerList players = allocate(RecordingPlayerList.class);
+
+        players.setPlayerFileData(new WorldServer[]{mainWorld});
+        border.setSize(512.0D);
+        border.transitionSizeBetween(512.0D, 256.0D, 1_000L);
+        border.setCenter(10.0D, 20.0D);
+        border.setWarningTime(10);
+        border.setWarningDistance(2);
+
+        assertSame(storage, players.playerFileData);
+        assertEquals(0, players.globalPacketCount);
+    }
+
+    private static void setWorldField(World world, String name, Object value) throws Exception {
+        Field field = World.class.getDeclaredField(name);
+        field.setAccessible(true);
+        field.set(world, value);
+    }
+
+    private static <T> T allocate(Class<T> type) throws Exception {
+        Class<?> unsafe = Class.forName("sun.misc.Unsafe");
+        Field field = unsafe.getDeclaredField("theUnsafe");
+        field.setAccessible(true);
+        return type.cast(unsafe.getMethod("allocateInstance", Class.class).invoke(field.get(null), type));
+    }
+
+    private static final class RecordingPlayerList extends PlayerList {
+        private int globalPacketCount;
+
+        private RecordingPlayerList() {
+            super(null);
+        }
+
+        @Override
+        public void sendAll(Packet packet) {
+            this.globalPacketCount++;
+        }
+    }
+}
