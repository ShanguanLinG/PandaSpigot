From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ShanguanLinG <bilibiliShanguanLinG@outlook.com>
Date: Thu, 29 Oct 2026 10:56:17 +0800
Subject: [PATCH] perf: lazily allocate entity slice storage and iterators


diff --git a/src/main/java/org/bukkit/craftbukkit/util/UnsafeList.java b/src/main/java/org/bukkit/craftbukkit/util/UnsafeList.java
index 08d105603c604fcb1a90e00e9ff83bee55621828..3907c2e66b5b3e8f2804b60acc9aeb8218aa081f 100644
--- a/src/main/java/org/bukkit/craftbukkit/util/UnsafeList.java
+++ b/src/main/java/org/bukkit/craftbukkit/util/UnsafeList.java
@@ -16,23 +16,26 @@ import java.util.RandomAccess;
 @SuppressWarnings("unchecked")
 public class UnsafeList<E> extends AbstractList<E> implements List<E>, RandomAccess, Cloneable, Serializable {
     private static final long serialVersionUID = 8683452581112892191L;
+    // PandaSpigot start - Empty chunk slices need no backing storage or iterator pool
+    private static final Object[] EMPTY_DATA = new Object[0];
+    private static final Iterator[] EMPTY_ITERATORS = new Iterator[0];
+    // PandaSpigot end
 
     private transient Object[] data;
     private int size;
     private int initialCapacity;
 
-    private Iterator[] iterPool = new Iterator[1];
+    private transient Iterator[] iterPool = EMPTY_ITERATORS; // PandaSpigot - Runtime-only, lazily allocated
     private int maxPool;
     private int poolCounter;
 
     public UnsafeList(int capacity, int maxIterPool) {
         super();
         if (capacity < 0) capacity = 32;
-        int rounded = Integer.highestOneBit(capacity - 1) << 1;
-        data = new Object[rounded];
+        int rounded = Math.max(1, Integer.highestOneBit(capacity - 1) << 1); // PandaSpigot - Allow growth from zero capacity
+        data = EMPTY_DATA; // PandaSpigot - Allocate on first insertion
         initialCapacity = rounded;
         maxPool = maxIterPool;
-        iterPool[0] = new Itr();
     }
 
     public UnsafeList(int capacity) {
@@ -128,7 +131,7 @@ public class UnsafeList<E> extends AbstractList<E> implements List<E>, RandomAcc
     // actually rounds up to nearest power of two
     public void trimToSize() {
         int old = data.length;
-        int rounded = Integer.highestOneBit(size - 1) << 1;
+        int rounded = size == 0 ? 0 : Math.max(1, Integer.highestOneBit(size - 1) << 1); // PandaSpigot
         if (rounded < old) {
             data = Arrays.copyOf(data, rounded);
         }
@@ -144,17 +147,22 @@ public class UnsafeList<E> extends AbstractList<E> implements List<E>, RandomAcc
 
     public Object clone() throws CloneNotSupportedException {
         UnsafeList<E> copy = (UnsafeList<E>) super.clone();
-        copy.data = Arrays.copyOf(data, size);
+        copy.data = size == 0 ? EMPTY_DATA : Arrays.copyOf(data, size); // PandaSpigot
         copy.size = size;
         copy.initialCapacity = initialCapacity;
-        copy.iterPool = new Iterator[1];
-        copy.iterPool[0] = new Itr();
+        copy.iterPool = EMPTY_ITERATORS; // PandaSpigot - Iterators must belong to the clone
         copy.maxPool = maxPool;
         copy.poolCounter = 0;
         return copy;
     }
 
     public Iterator<E> iterator() {
+        // PandaSpigot start - Allocate the first iterator only when requested
+        if (iterPool.length == 0) {
+            iterPool = new Iterator[] { new Itr() };
+            return iterPool[0];
+        }
+        // PandaSpigot end
         // Try to find an iterator that isn't in use
         for (Iterator iter : iterPool) {
             if (!((Itr) iter).valid) {
@@ -189,7 +197,7 @@ public class UnsafeList<E> extends AbstractList<E> implements List<E>, RandomAcc
 
     private void growIfNeeded() {
         if (size == data.length) {
-            Object[] newData = new Object[data.length << 1];
+            Object[] newData = new Object[data.length == 0 ? initialCapacity : data.length << 1]; // PandaSpigot
             System.arraycopy(data, 0, newData, 0, size);
             data = newData;
         }
@@ -211,13 +219,12 @@ public class UnsafeList<E> extends AbstractList<E> implements List<E>, RandomAcc
 
         size = is.readInt();
         initialCapacity = is.readInt();
-        data = new Object[Integer.highestOneBit(size - 1) << 1];
+        data = size == 0 ? EMPTY_DATA : new Object[Math.max(1, Integer.highestOneBit(size - 1) << 1)]; // PandaSpigot
         for (int i = 0; i < size; i++) {
             data[i] = is.readObject();
         }
         maxPool = is.readInt();
-        iterPool = new Iterator[1];
-        iterPool[0] = new Itr();
+        iterPool = EMPTY_ITERATORS; // PandaSpigot
     }
 
     public class Itr implements Iterator<E> {
diff --git a/src/test/java/org/bukkit/craftbukkit/util/UnsafeListTest.java b/src/test/java/org/bukkit/craftbukkit/util/UnsafeListTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..1bdf3ac79d4cb1320d44fe9f6abaf41d1196a31f
--- /dev/null
+++ b/src/test/java/org/bukkit/craftbukkit/util/UnsafeListTest.java
@@ -0,0 +1,77 @@
+package org.bukkit.craftbukkit.util;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.util.Arrays;
+import java.util.Iterator;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class UnsafeListTest {
+    @Test
+    public void smallListsGrowAfterEmptyIterationTrimmingAndClearing() {
+        for (int capacity : new int[] {0, 1, 32}) {
+            UnsafeList<Integer> values = new UnsafeList<>(capacity);
+            assertFalse(values.iterator().hasNext());
+            values.add(7);
+            values.trimToSize();
+            assertEquals(Integer.valueOf(7), values.get(0));
+            values.add(0, 3);
+            for (int i = 0; i < 80; i++) values.add(i);
+            assertEquals(Integer.valueOf(3), values.remove(0));
+            assertEquals(Integer.valueOf(7), values.get(0));
+            values.clear();
+            values.trimToSize();
+            values.add(9);
+            assertEquals(Arrays.asList(9), values);
+        }
+    }
+
+    @Test
+    public void nestedIteratorsAndExplicitReusePreserveIndependentPositions() {
+        UnsafeList<Integer> values = new UnsafeList<>(32, 2);
+        values.addAll(Arrays.asList(1, 2, 3));
+        Iterator<Integer> first = values.iterator();
+        assertEquals(Integer.valueOf(1), first.next());
+        Iterator<Integer> second = values.iterator();
+        assertEquals(Integer.valueOf(1), second.next());
+        assertEquals(Integer.valueOf(2), first.next());
+        first.remove();
+        assertEquals(Arrays.asList(1, 3), values);
+        ((UnsafeList.Itr) first).valid = false;
+        Iterator<Integer> reused = values.iterator();
+        assertSame(first, reused);
+        assertEquals(Integer.valueOf(1), reused.next());
+        assertEquals(Integer.valueOf(3), reused.next());
+        assertFalse(reused.hasNext());
+    }
+
+    @Test
+    public void clonedAndDeserializedListsOwnTheirStorageAndIterators() throws Exception {
+        UnsafeList<String> original = new UnsafeList<>();
+        for (boolean populated : new boolean[] {false, true}) {
+            if (populated) original.add("original");
+            original.iterator();
+            UnsafeList<String> clone = (UnsafeList<String>) original.clone();
+            ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+            try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {
+                output.writeObject(original);
+            }
+            UnsafeList<String> restored;
+            try (ObjectInputStream input = new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()))) {
+                restored = (UnsafeList<String>) input.readObject();
+            }
+            for (UnsafeList<String> copy : Arrays.asList(clone, restored)) {
+                assertEquals(original, copy);
+                copy.add("copy");
+                Iterator<String> iterator = copy.iterator();
+                if (populated) assertEquals("original", iterator.next());
+                assertEquals("copy", iterator.next());
+                iterator.remove();
+                assertEquals(original, copy);
+            }
+        }
+    }
+}
