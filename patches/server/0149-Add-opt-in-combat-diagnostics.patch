index 0000000000000000000000000000000000000000..4134e2e4c64640d9df1558db088f9e6c9a9adc52
--- /dev/null
+++ b/src/main/java/com/hpfxd/pandaspigot/diagnostics/CombatTrace.java
@@ -0,0 +1,227 @@
+package com.hpfxd.pandaspigot.diagnostics;
+
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import java.util.function.Consumer;
+import java.util.function.ToLongFunction;
+import java.util.logging.Level;
+import java.util.logging.Logger;
+
+import net.minecraft.server.DamageSource;
+import net.minecraft.server.Entity;
+import net.minecraft.server.EntityHuman;
+import net.minecraft.server.EntityLiving;
+import net.minecraft.server.EntityPlayer;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.Packet;
+import net.minecraft.server.PacketListener;
+import net.minecraft.server.PacketPlayInUseEntity;
+import net.minecraft.server.PlayerConnection;
+
+public final class CombatTrace {
+    private static final Logger LOGGER = Logger.getLogger("PandaSpigot.CombatTrace");
+    private static final ThreadLocal<Long> PACKET = new ThreadLocal<>();
+    private static final ThreadLocal<Long> DAMAGE = new ThreadLocal<>();
+    private static final Scope DISABLED = new Scope(null, null);
+    private static volatile Capture capture;
+
+    private CombatTrace() {
+    }
+
+    public static synchronized void install(Set<UUID> players, Consumer<Map<String, Object>> sink, ToLongFunction<Object> ids) {
+        if (capture != null) throw new IllegalStateException("A core combat diagnostic sink is already installed");
+        if (players.isEmpty() || sink == null || ids == null)
+            throw new IllegalArgumentException("Invalid core diagnostic capture");
+        capture = new Capture(Collections.unmodifiableSet(new HashSet<>(players)), sink, ids);
+    }
+
+    public static synchronized void uninstall(Consumer<Map<String, Object>> sink) {
+        Capture current = capture;
+        if (current != null && current.sink == sink) capture = null;
+    }
+
+    public static long currentPacketId() {
+        Long id = PACKET.get();
+        return id == null ? 0 : id;
+    }
+
+    public static Scope packet(EntityPlayer player, PacketPlayInUseEntity packet, Entity target) {
+        Capture current = capture;
+        if (current == null || packet.a() != PacketPlayInUseEntity.EnumEntityUseAction.ATTACK
+                || !selected(current, player, target)) return DISABLED;
+        Long previous = PACKET.get();
+        try {
+            PACKET.set(current.ids.applyAsLong(packet));
+            log(player, target, "connection.attack.enter", "action", packet.a().name());
+            return new Scope(PACKET, previous);
+        } catch (RuntimeException | LinkageError failure) {
+            fail(current, failure);
+            if (previous == null) PACKET.remove();
+            else PACKET.set(previous);
+            return DISABLED;
+        }
+    }
+
+    public static long currentDamageId() {
+        Long id = DAMAGE.get();
+        return id == null ? 0 : id;
+    }
+
+    public static Scope damage(EntityLiving target, DamageSource source, float raw, Class<?> layer) {
+        Capture current = capture;
+        if (current == null || layer == EntityLiving.class && target instanceof EntityHuman
+                || layer == EntityHuman.class && target instanceof EntityPlayer
+                || !selected(current, source.getEntity(), target)) return DISABLED;
+        Long previous = DAMAGE.get();
+        try {
+            DAMAGE.set(current.ids.applyAsLong(new Object()));
+            log(source.getEntity(), target, "damage.call.enter", "raw", raw,
+                    "parentDamageId", previous == null ? 0L : previous, "directSource", state(source.i()));
+            return new Scope(DAMAGE, previous);
+        } catch (RuntimeException | LinkageError failure) {
+            fail(current, failure);
+            if (previous == null) DAMAGE.remove();
+            else DAMAGE.set(previous);
+            return DISABLED;
+        }
+    }
+
+    public static void network(PacketListener listener, Packet packet, String reason) {
+        Capture current = capture;
+        if (current == null || !(listener instanceof PlayerConnection) || !(packet instanceof PacketPlayInUseEntity))
+            return;
+        EntityPlayer player = ((PlayerConnection) listener).player;
+        if (!current.players.contains(player.getUniqueID())) return;
+        try {
+            Map<String, Object> fields = new LinkedHashMap<>();
+            fields.put("stage", "network.reject");
+            fields.put("packetId", current.ids.applyAsLong(packet));
+            fields.put("player", player.getUniqueID().toString());
+            fields.put("reason", reason);
+            current.sink.accept(fields);
+        } catch (RuntimeException | LinkageError failure) {
+            fail(current, failure);
+        }
+    }
+
+    public static void log(Entity source, Entity target, String stage, Object... values) {
+        Capture current = capture;
+        if (current == null || !selected(current, source, target)) return;
+        try {
+            Map<String, Object> fields = new LinkedHashMap<>();
+            fields.put("stage", stage);
+            fields.put("tick", MinecraftServer.currentTick);
+            fields.put("packetId", currentPacketId());
+            fields.put("damageId", currentDamageId());
+            fields.put("source", state(source));
+            fields.put("target", state(target));
+            for (int i = 0; i < values.length; i += 2) fields.put((String) values[i], values[i + 1]);
+            current.sink.accept(fields);
+        } catch (RuntimeException | LinkageError failure) {
+            fail(current, failure);
+        }
+    }
+
+    public static boolean damageResult(EntityLiving target, DamageSource source, float amount, boolean accepted, String reason) {
+        if (capture != null)
+            log(source.getEntity(), target, "damage.result", "raw", amount, "accepted", accepted, "reason", reason);
+        return accepted;
+    }
+
+    public static void write(EntityLiving target, String field, Object previous, Object value, String reason) {
+        Capture current = capture;
+        if (current == null || !current.players.contains(target.getUniqueID())) return;
+        StringBuilder callers = new StringBuilder();
+        StackTraceElement[] stack = Thread.currentThread().getStackTrace();
+        for (int i = 2; i < Math.min(stack.length, 14); i++) callers.append(stack[i]).append('\n');
+        log(null, target, "state.write", "field", field, "before", previous, "after", value, "reason", reason, "callers", callers.toString());
+    }
+
+    public static boolean enabled() {
+        return capture != null;
+    }
+
+    private static boolean selected(Capture current, Entity source, Entity target) {
+        return source != null && current.players.contains(source.getUniqueID())
+                || target != null && current.players.contains(target.getUniqueID());
+    }
+
+    private static Map<String, Object> state(Entity entity) {
+        if (entity == null) return null;
+        Map<String, Object> state = new LinkedHashMap<>();
+        state.put("uuid", entity.getUniqueID().toString());
+        state.put("entityId", entity.getId());
+        state.put("x", entity.locX);
+        state.put("y", entity.locY);
+        state.put("z", entity.locZ);
+        state.put("motionX", entity.motX);
+        state.put("motionY", entity.motY);
+        state.put("motionZ", entity.motZ);
+        state.put("sprint", entity.isSprinting());
+        state.put("dead", entity.dead);
+        state.put("onGround", entity.onGround);
+        state.put("fallDistance", entity.fallDistance);
+        state.put("yaw", entity.yaw);
+        state.put("pitch", entity.pitch);
+        if (entity instanceof EntityLiving) {
+            EntityLiving living = (EntityLiving) entity;
+            state.put("noDamageTicks", living.noDamageTicks);
+            state.put("maximumNoDamageTicks", living.maxNoDamageTicks);
+            state.put("lastDamage", living.lastDamage);
+            state.put("health", living.getHealth());
+            state.put("absorption", living.getAbsorptionHearts());
+        }
+        return state;
+    }
+
+    private static synchronized void fail(Capture current, Throwable failure) {
+        if (capture == current) capture = null;
+        LOGGER.log(Level.SEVERE, "Core combat diagnostics disabled after capture failure", failure);
+    }
+
+    public static final class Scope implements AutoCloseable {
+        private final ThreadLocal<Long> context;
+        private final Long previous;
+
+        private Scope(ThreadLocal<Long> context, Long previous) {
+            this.context = context;
+            this.previous = previous;
+        }
+
+        @Override
+        public void close() {
+            if (this.context == null) return;
+            Capture current = capture;
+            if (current != null) {
+                try {
+                    Map<String, Object> fields = new LinkedHashMap<>();
+                    fields.put("stage", this.context == DAMAGE ? "damage.call.exit" : "connection.attack.exit");
+                    fields.put("packetId", currentPacketId());
+                    fields.put("damageId", currentDamageId());
+                    fields.put("tick", MinecraftServer.currentTick);
+                    current.sink.accept(fields);
+                } catch (RuntimeException | LinkageError failure) {
+                    fail(current, failure);
+                }
+            }
+            if (this.previous == null) this.context.remove();
+            else this.context.set(this.previous);
+        }
+    }
+
+    private static final class Capture {
+        final Set<UUID> players;
+        final Consumer<Map<String, Object>> sink;
+        final ToLongFunction<Object> ids;
+
+        Capture(Set<UUID> players, Consumer<Map<String, Object>> sink, ToLongFunction<Object> ids) {
+            this.players = players;
+            this.sink = sink;
+            this.ids = ids;
+        }
+    }
+}
