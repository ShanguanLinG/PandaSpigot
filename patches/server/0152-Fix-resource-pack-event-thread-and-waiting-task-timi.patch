+        long duration = endTime - start - this.tickIdleNanos;
+        this.h[this.ticks % 100] = duration;
+        new com.destroystokyo.paper.event.server.ServerTickEndEvent(this.ticks, duration / 1000000D, this.ab - endTime).callEvent();
