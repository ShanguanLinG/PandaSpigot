+    // PandaSpigot end
+
     @Override
     public void a(PacketDataSerializer packetdataserializer) throws IOException {
         this.a = packetdataserializer.e();
diff --git a/src/test/java/net/minecraft/server/EntityEquipmentPacketTest.java b/src/test/java/net/minecraft/server/EntityEquipmentPacketTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..6aa975cbe459377c3c1ed7c0062565d0e0c1bb84
--- /dev/null
+++ b/src/test/java/net/minecraft/server/EntityEquipmentPacketTest.java
@@ -0,0 +1,35 @@
+package net.minecraft.server;
+
+import java.lang.reflect.Field;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+
+import static org.junit.Assert.*;
+
+public class EntityEquipmentPacketTest extends AbstractTestingBase {
+    @Test
+    public void recipientCopiesDoNotShareItemTags() throws Exception {
+        ItemStack helmet = new ItemStack(Items.IRON_HELMET);
+        NBTTagCompound nested = new NBTTagCompound();
+        nested.setByteArray("bytes", new byte[]{1, 2});
+        NBTTagCompound tags = new NBTTagCompound();
+        tags.set("nested", nested);
+        helmet.setTag(tags);
+        PacketPlayOutEntityEquipment original = new PacketPlayOutEntityEquipment(42, 4, helmet);
+        PacketPlayOutEntityEquipment first = original.copy();
+        PacketPlayOutEntityEquipment second = original.copy();
+        Field item = PacketPlayOutEntityEquipment.class.getDeclaredField("c");
+        item.setAccessible(true);
+        ((ItemStack) item.get(first)).getTag().getCompound("nested").getByteArray("bytes")[0] = 9;
+        item.set(first, null);
+        assertEquals(1, ((ItemStack) item.get(second)).getTag().getCompound("nested").getByteArray("bytes")[0]);
+        assertEquals(1, ((ItemStack) item.get(original)).getTag().getCompound("nested").getByteArray("bytes")[0]);
+        assertEquals(1, helmet.getTag().getCompound("nested").getByteArray("bytes")[0]);
+        for (String name : new String[]{"a", "b"}) {
+            Field field = PacketPlayOutEntityEquipment.class.getDeclaredField(name);
+            field.setAccessible(true);
+            assertEquals(field.get(original), field.get(second));
+        }
+        assertNull(item.get(new PacketPlayOutEntityEquipment(42, 4, null).copy()));
+    }
+}
