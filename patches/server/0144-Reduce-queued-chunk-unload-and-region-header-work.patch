diff --git a/src/test/java/net/minecraft/server/RegionFileHeaderTest.java b/src/test/java/net/minecraft/server/RegionFileHeaderTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..ac21150359abbed4b5d35078295196283a5318ed
--- /dev/null
+++ b/src/test/java/net/minecraft/server/RegionFileHeaderTest.java
@@ -0,0 +1,160 @@
+package net.minecraft.server;
+
+import java.io.DataInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataOutputStream;
+import java.io.File;
+import java.io.IOException;
+import java.io.RandomAccessFile;
+import java.lang.reflect.Field;
+import java.util.zip.GZIPOutputStream;
+
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+import static org.junit.Assert.*;
+
+public class RegionFileHeaderTest {
+    @Rule
+    public TemporaryFolder temporary = new TemporaryFolder();
+
+    @Test
+    public void headersUseOneBulkReadAndPayloadsSurviveOverwritesAndReopening() throws Exception {
+        File file = temporary.newFile();
+        RegionFile region = new RegionFile(file);
+        assertFalse(region.chunkExists(0, 0));
+        write(region, "before");
+        Field input = RegionFile.class.getDeclaredField("c");
+        input.setAccessible(true);
+        ((RandomAccessFile) input.get(region)).close();
+        CountingFile counted = new CountingFile(file);
+        input.set(region, counted);
+        try {
+            assertTrue(region.chunkExists(0, 0));
+            assertEquals(1, counted.bulkReads);
+            assertEquals(0, counted.singleReads);
+            counted.bulkReads = 0;
+            try (DataInputStream data = region.a(0, 0)) {
+                assertEquals("before", data.readUTF());
+            }
+            assertEquals(2, counted.bulkReads);
+            assertEquals(0, counted.singleReads);
+            write(region, "after");
+            assertTrue(region.chunkExists(0, 0));
+        } finally {
+            region.c();
+        }
+        RegionFile reopened = new RegionFile(file);
+        try (DataInputStream data = reopened.a(0, 0)) {
+            assertEquals("after", data.readUTF());
+            assertTrue(reopened.chunkExists(0, 0));
+        } finally {
+            reopened.c();
+        }
+    }
+
+    @Test
+    public void gzipRecordsStillValidateAndDecode() throws Exception {
+        File file = savedFile();
+        ByteArrayOutputStream compressed = new ByteArrayOutputStream();
+        try (DataOutputStream data = new DataOutputStream(new GZIPOutputStream(compressed))) {
+            data.writeUTF("gzip");
+        }
+        try (RandomAccessFile raw = new RandomAccessFile(file, "rw")) {
+            raw.seek(recordOffset(raw));
+            raw.writeInt(compressed.size() + 1);
+            raw.writeByte(1);
+            raw.write(compressed.toByteArray());
+        }
+        RegionFile region = new RegionFile(file);
+        try (DataInputStream data = region.a(0, 0)) {
+            assertTrue(region.chunkExists(0, 0));
+            assertEquals("gzip", data.readUTF());
+        } finally {
+            region.c();
+        }
+    }
+
+    @Test
+    public void invalidLengthsCompressionAndTruncatedHeadersRemainRejected() throws Exception {
+        for (int invalidLength : new int[]{0, -1, 8192}) {
+            File file = savedFile();
+            try (RandomAccessFile raw = new RandomAccessFile(file, "rw")) {
+                raw.seek(recordOffset(raw));
+                raw.writeInt(invalidLength);
+            }
+            assertRejected(file);
+        }
+        File compression = savedFile();
+        try (RandomAccessFile raw = new RandomAccessFile(compression, "rw")) {
+            raw.seek(recordOffset(raw) + 4);
+            raw.writeByte(3);
+        }
+        assertRejected(compression);
+        File truncated = savedFile();
+        try (RandomAccessFile raw = new RandomAccessFile(truncated, "rw")) {
+            raw.setLength(recordOffset(raw) + 4);
+        }
+        assertRejected(truncated);
+    }
+
+    private File savedFile() throws IOException {
+        File file = temporary.newFile();
+        RegionFile region = new RegionFile(file);
+        try {
+            write(region, "payload");
+        } finally {
+            region.c();
+        }
+        return file;
+    }
+
+    private static void write(RegionFile region, String value) throws IOException {
+        try (DataOutputStream data = region.b(0, 0)) {
+            data.writeUTF(value);
+        }
+    }
+
+    private static long recordOffset(RandomAccessFile raw) throws IOException {
+        raw.seek(0);
+        return (raw.readInt() >>> 8) * 4096L;
+    }
+
+    private static void assertRejected(File file) throws IOException {
+        RegionFile region = new RegionFile(file);
+        try {
+            assertFalse(region.chunkExists(0, 0));
+            assertNull(region.a(0, 0));
+        } finally {
+            region.c();
+        }
+    }
+
+    private static final class CountingFile extends RandomAccessFile {
+        int bulkReads;
+        int singleReads;
+
+        CountingFile(File file) throws IOException {
+            super(file, "rw");
+        }
+
+        @Override
+        public int read() throws IOException {
+            singleReads++;
+            return super.read();
+        }
+
+        @Override
+        public int read(byte[] buffer) throws IOException {
+            bulkReads++;
+            return super.read(buffer);
+        }
+
+        @Override
+        public int read(byte[] buffer, int offset, int length) throws IOException {
+            bulkReads++;
+            return super.read(buffer, offset, length);
+        }
+    }
+}
