diff --git a/src/test/java/net/minecraft/server/ChunkProviderServerAutoSaveTest.java b/src/test/java/net/minecraft/server/ChunkProviderServerAutoSaveTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..da525f11e92953541feab04e3989d1dc7334f482
--- /dev/null
+++ b/src/test/java/net/minecraft/server/ChunkProviderServerAutoSaveTest.java
@@ -0,0 +1,209 @@
+package net.minecraft.server;
+
+import com.hpfxd.pandaspigot.config.PandaSpigotConfig;
+import com.hpfxd.pandaspigot.config.PandaSpigotWorldConfig;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+
+import static org.junit.Assert.*;
+
+public class ChunkProviderServerAutoSaveTest extends AbstractTestingBase {
+    @Test
+    public void automaticSaveUsesCurrentStateAndSkipsUnloadedInstances() throws Exception {
+        RecordingProvider provider = provider();
+        Chunk original = chunk(provider, 0);
+        Chunk later = chunk(provider, 1);
+        provider.startAutomaticSave();
+        assertTrue(provider.saveNextAutomaticChunk());
+        Chunk pending = provider.saved.get(0) == original ? later : original;
+        provider.chunks.remove(org.bukkit.craftbukkit.util.LongHash.toLong(pending.locX, pending.locZ));
+        Chunk replacement = chunk(provider, pending.locX);
+        assertTrue(provider.saveNextAutomaticChunk());
+        assertFalse(provider.saved.contains(pending));
+        assertFalse(provider.saved.contains(replacement));
+        assertFalse(provider.saveNextAutomaticChunk());
+        provider.startAutomaticSave();
+        drain(provider);
+        assertTrue(provider.saved.contains(replacement));
+    }
+
+    @Test
+    public void changesBeforeProcessingAndOverlappingCyclesAreRetained() throws Exception {
+        RecordingProvider provider = provider();
+        Chunk first = chunk(provider, 0);
+        Chunk second = chunk(provider, 1);
+        provider.startAutomaticSave();
+        provider.saveNextAutomaticChunk();
+        Chunk saved = provider.saved.get(0);
+        Chunk pending = saved == first ? second : first;
+        pending.f(false);
+        pending.f(true);
+        saved.f(true);
+        provider.startAutomaticSave();
+        drain(provider);
+        assertEquals(3, provider.saved.size());
+        assertEquals(2, java.util.Collections.frequency(provider.saved, saved));
+        assertEquals(1, java.util.Collections.frequency(provider.saved, pending));
+    }
+
+    @Test
+    public void explicitSavesCompleteAndCancelPendingAutomaticWork() throws Exception {
+        for (boolean force : new boolean[]{false, true}) {
+            RecordingProvider provider = provider();
+            Chunk first = chunk(provider, 0);
+            Chunk second = chunk(provider, 1);
+            provider.startAutomaticSave();
+            provider.saveNextAutomaticChunk();
+            first.f(true);
+            second.f(true);
+            int before = provider.saved.size();
+            assertTrue(provider.saveChunks(force, null));
+            assertEquals(before + 2, provider.saved.size());
+            assertEquals(force ? 2 : 0, provider.extraSaves);
+            assertFalse(provider.saveNextAutomaticChunk());
+        }
+    }
+
+    @Test
+    public void disabledChunkSavingCancelsPendingWorkWithoutClearingDirtyState() throws Exception {
+        RecordingProvider provider = provider();
+        Chunk chunk = chunk(provider, 0);
+        provider.startAutomaticSave();
+        provider.world.pandaSpigotConfig.disableChunkSaving = true;
+        assertFalse(provider.saveNextAutomaticChunk());
+        assertTrue(chunk.a(false));
+        provider.world.pandaSpigotConfig.disableChunkSaving = false;
+        assertFalse(provider.saveNextAutomaticChunk());
+        provider.startAutomaticSave();
+        drain(provider);
+        assertEquals(Arrays.asList(chunk), provider.saved);
+    }
+
+    @Test
+    public void entityOnlyChunksKeepTheirAutomaticSaveInterval() throws Exception {
+        RecordingProvider provider = provider();
+        provider.world.worldData = new WorldData(new NBTTagCompound());
+        Chunk chunk = chunk(provider, 0);
+        chunk.f(false);
+        chunk.g(true);
+        DedicatedServer server = allocate(DedicatedServer.class);
+        server.autosavePeriod = 20;
+        Field serverField = MinecraftServer.class.getDeclaredField("l");
+        serverField.setAccessible(true);
+        Object previous = serverField.get(null);
+        try {
+            serverField.set(null, server);
+            provider.world.worldData.setTime(79);
+            provider.startAutomaticSave();
+            drain(provider);
+            assertTrue(provider.saved.isEmpty());
+            provider.world.worldData.setTime(80);
+            provider.startAutomaticSave();
+            drain(provider);
+            assertEquals(Arrays.asList(chunk), provider.saved);
+            provider.world.worldData.setTime(81);
+            provider.saveChunks(true, null);
+            assertEquals(2, provider.saved.size());
+        } finally {
+            serverField.set(null, previous);
+        }
+    }
+
+    @Test
+    public void serverSharesCountAndTimeBudgetsAcrossWorlds() throws Exception {
+        RecordingProvider first = provider();
+        RecordingProvider second = provider();
+        for (int index = 0; index < 4; index++) {
+            chunk(first, index);
+            chunk(second, index);
+        }
+        first.world.chunkProviderServer = first;
+        second.world.chunkProviderServer = second;
+        DedicatedServer server = allocate(DedicatedServer.class);
+        server.worlds = new ArrayList<>(Arrays.asList(first.world, second.world));
+        PandaSpigotConfig config = new PandaSpigotConfig();
+        config.autoSaveMaxMillisPerTick = 10000;
+        config.autoSaveMaxChunksPerTick = 3;
+        Field configField = PandaSpigotConfig.class.getDeclaredField("config");
+        configField.setAccessible(true);
+        Object previous = configField.get(null);
+        Method save = MinecraftServer.class.getDeclaredMethod("saveAutomaticChunks");
+        save.setAccessible(true);
+        try {
+            configField.set(null, config);
+            first.startAutomaticSave();
+            second.startAutomaticSave();
+            save.invoke(server);
+            assertEquals(2, first.saved.size());
+            assertEquals(1, second.saved.size());
+            save.invoke(server);
+            assertEquals(3, first.saved.size());
+            assertEquals(3, second.saved.size());
+            config.autoSaveMaxMillisPerTick = 10;
+            first.delayMillis = second.delayMillis = 50;
+            save.invoke(server);
+            assertEquals(7, first.saved.size() + second.saved.size());
+            save.invoke(server);
+            assertEquals(8, first.saved.size() + second.saved.size());
+        } finally {
+            configField.set(null, previous);
+        }
+    }
+
+    private static RecordingProvider provider() throws Exception {
+        WorldServer world = allocate(WorldServer.class);
+        world.pandaSpigotConfig = new PandaSpigotWorldConfig();
+        return new RecordingProvider(world);
+    }
+
+    private static Chunk chunk(RecordingProvider provider, int x) {
+        Chunk chunk = new Chunk(provider.world, x, 0);
+        chunk.f(true);
+        provider.chunks.put(org.bukkit.craftbukkit.util.LongHash.toLong(x, 0), chunk);
+        return chunk;
+    }
+
+    private static void drain(RecordingProvider provider) {
+        int remaining = 20;
+        while (provider.saveNextAutomaticChunk()) assertTrue(--remaining > 0);
+    }
+
+    private static <T> T allocate(Class<T> type) throws Exception {
+        Class<?> unsafe = Class.forName("sun.misc.Unsafe");
+        Field field = unsafe.getDeclaredField("theUnsafe");
+        field.setAccessible(true);
+        return type.cast(unsafe.getMethod("allocateInstance", Class.class).invoke(field.get(null), type));
+    }
+
+    private static final class RecordingProvider extends ChunkProviderServer {
+        final List<Chunk> saved = new ArrayList<>();
+        int extraSaves;
+        long delayMillis;
+
+        RecordingProvider(WorldServer world) {
+            super(world, null, null);
+        }
+
+        @Override
+        public void saveChunk(Chunk chunk) {
+            saved.add(chunk);
+            if (delayMillis > 0) {
+                try {
+                    Thread.sleep(delayMillis);
+                } catch (InterruptedException exception) {
+                    throw new AssertionError(exception);
+                }
+            }
+        }
+
+        @Override
+        public void saveChunkNOP(Chunk chunk) {
+            extraSaves++;
+        }
+    }
+}
