diff --git a/src/test/java/net/minecraft/server/NetworkTickBoundaryTest.java b/src/test/java/net/minecraft/server/NetworkTickBoundaryTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..ffde27d7158ef32ea5fb9fab58b2353d4bb9edec
--- /dev/null
+++ b/src/test/java/net/minecraft/server/NetworkTickBoundaryTest.java
@@ -0,0 +1,157 @@
+package net.minecraft.server;
+
+import com.destroystokyo.paper.event.server.ServerTickEndEvent;
+import java.lang.reflect.Field;
+import java.lang.reflect.Proxy;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.ConcurrentLinkedQueue;
+import java.util.concurrent.atomic.AtomicReference;
+import org.bukkit.Bukkit;
+import org.bukkit.Server;
+import org.bukkit.craftbukkit.CraftServer;
+import org.bukkit.craftbukkit.entity.CraftPlayer;
+import org.bukkit.event.Event;
+import org.bukkit.event.EventPriority;
+import org.bukkit.event.HandlerList;
+import org.bukkit.event.Listener;
+import org.bukkit.event.player.PlayerResourcePackStatusEvent;
+import org.bukkit.plugin.Plugin;
+import org.bukkit.plugin.RegisteredListener;
+import org.bukkit.plugin.SimplePluginManager;
+import org.junit.Test;
+
+import static org.junit.Assert.*;
+
+public class NetworkTickBoundaryTest {
+    @Test
+    public void resourcePackStatusQueuesWithoutWaitingForThePluginManagerLock() throws Exception {
+        TestServer server = server();
+        SimplePluginManager manager = new SimplePluginManager(null, null);
+        CraftServer craft = allocate(CraftServer.class);
+        set(CraftServer.class, craft, "pluginManager", manager);
+        try (EventRecorder recorder = new EventRecorder(PlayerResourcePackStatusEvent.getHandlerList())) {
+            TestConnection connection = allocate(TestConnection.class);
+            set(PlayerConnection.class, connection, "minecraftServer", server);
+            set(PlayerConnection.class, connection, "server", craft);
+            PacketPlayInResourcePackStatus packet = new PacketPlayInResourcePackStatus();
+            packet.b = PacketPlayInResourcePackStatus.EnumResourcePackStatus.ACCEPTED;
+            AtomicReference<Throwable> failure = new AtomicReference<>();
+            Thread network = new Thread(() -> {
+                try {
+                    connection.a(packet);
+                    failure.set(new AssertionError("Async packet handling must be rescheduled"));
+                } catch (CancelledPacketHandleException expected) {
+                } catch (Throwable error) {
+                    failure.set(error);
+                }
+            });
+            boolean waiting;
+            synchronized (manager) {
+                network.start();
+                network.join(1000);
+                waiting = network.isAlive();
+            }
+            network.join(1000);
+            assertFalse("Network thread must not acquire the event lock", waiting);
+            assertNull(failure.get());
+            assertTrue(recorder.events.isEmpty());
+            server.runAllTasks();
+            assertEquals(1, recorder.events.size());
+            assertSame(Thread.currentThread(), recorder.eventThread);
+            assertEquals(PlayerResourcePackStatusEvent.Status.ACCEPTED,
+                    ((PlayerResourcePackStatusEvent) recorder.events.get(0)).getStatus());
+        }
+    }
+
+    @Test
+    public void tickDurationIncludesQueuedWorkAndNestedWaitsButExcludesIdleParking() throws Exception {
+        TestServer server = server();
+        SimplePluginManager manager = new SimplePluginManager(null, null);
+        Server previous = Bukkit.getServer();
+        Server proxy = (Server) Proxy.newProxyInstance(Server.class.getClassLoader(), new Class<?>[]{Server.class},
+                (object, method, arguments) -> {
+                    if (method.getName().equals("getPluginManager")) return manager;
+                    if (method.getName().equals("isPrimaryThread")) return true;
+                    throw new UnsupportedOperationException(method.getName());
+                });
+        set(Bukkit.class, null, "server", proxy);
+        try (EventRecorder recorder = new EventRecorder(ServerTickEndEvent.getHandlerList())) {
+            set(MinecraftServer.class, server, "waitingForNextTick", true);
+            server.clockStep = 10000000L;
+            server.waitForTasks();
+            server.clockStep = 0;
+            server.now = 20000000L;
+            server.schedule(new TickTask(0, () -> {
+                server.clockStep = 10000000L;
+                server.waitForTasks();
+                server.clockStep = 0;
+                server.now += 30000000L;
+            }));
+            server.runAllTasks();
+            server.finishTick(0);
+            assertEquals(50000000L, server.h[0]);
+            assertEquals(50D, ((ServerTickEndEvent) recorder.events.get(0)).getTickDuration(), 0D);
+        } finally {
+            set(Bukkit.class, null, "server", previous);
+        }
+    }
+
+    private static TestServer server() throws Exception {
+        TestServer server = allocate(TestServer.class);
+        server.thread = Thread.currentThread();
+        set(IAsyncTaskHandler.class, server, "pendingTasks", new ConcurrentLinkedQueue<TickTask>());
+        set(MinecraftServer.class, server, "h", new long[100]);
+        return server;
+    }
+
+    private static void set(Class<?> type, Object target, String name, Object value) throws Exception {
+        Field field = type.getDeclaredField(name);
+        field.setAccessible(true);
+        field.set(target, value);
+    }
+
+    private static <T> T allocate(Class<T> type) throws Exception {
+        Class<?> unsafe = Class.forName("sun.misc.Unsafe");
+        Field field = unsafe.getDeclaredField("theUnsafe");
+        field.setAccessible(true);
+        return type.cast(unsafe.getMethod("allocateInstance", Class.class).invoke(field.get(null), type));
+    }
+
+    private static class TestServer extends DedicatedServer {
+        private Thread thread;
+        private long now;
+        private long clockStep;
+        private TestServer() { super(null); }
+        @Override public Thread aM() { return thread; }
+        @Override public long getNanoTime() { long value = now; now += clockStep; return value; }
+        @Override protected boolean shouldRun(TickTask task) { return true; }
+    }
+
+    private static class TestConnection extends PlayerConnection {
+        private TestConnection() { super(null, null, null); }
+        @Override public CraftPlayer getPlayer() { return null; }
+    }
+
+    private static class EventRecorder implements AutoCloseable {
+        private final List<Event> events = new ArrayList<>();
+        private final HandlerList handlers;
+        private final RegisteredListener registration;
+        private Thread eventThread;
+
+        private EventRecorder(HandlerList handlers) {
+            this.handlers = handlers;
+            Plugin plugin = (Plugin) Proxy.newProxyInstance(Plugin.class.getClassLoader(), new Class<?>[]{Plugin.class},
+                    (object, method, arguments) -> method.getName().equals("isEnabled"));
+            registration = new RegisteredListener(new Listener() {}, (listener, event) -> {
+                events.add(event);
+                eventThread = Thread.currentThread();
+            }, EventPriority.NORMAL, plugin, false);
+            handlers.register(registration);
+        }
+
+        @Override public void close() {
+            handlers.unregister(registration);
+        }
+    }
+}
