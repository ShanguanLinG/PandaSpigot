Subject: [PATCH] Isolate equipment packets between recipients


diff --git a/src/main/java/net/minecraft/server/EntityTrackerEntry.java b/src/main/java/net/minecraft/server/EntityTrackerEntry.java
index 0b90b6f30ea09fb117281d5ddd2fc752d2c139b5..848e6435a5e539c2b701c5c2982d45d26b0a1ee3 100644
--- a/src/main/java/net/minecraft/server/EntityTrackerEntry.java
+++ b/src/main/java/net/minecraft/server/EntityTrackerEntry.java
@@ -301,7 +301,7 @@ public class EntityTrackerEntry {
         while (iterator.hasNext()) {
             EntityPlayer entityplayer = (EntityPlayer) iterator.next();
 
-            entityplayer.playerConnection.sendPacket(packet);
+            entityplayer.playerConnection.sendPacket(packet instanceof PacketPlayOutEntityEquipment ? ((PacketPlayOutEntityEquipment) packet).copy() : packet); // PandaSpigot
         }
 
     }
@@ -309,7 +309,7 @@ public class EntityTrackerEntry {
     public void broadcastIncludingSelf(Packet packet) {
         this.broadcast(packet);
         if (this.tracker instanceof EntityPlayer) {
-            ((EntityPlayer) this.tracker).playerConnection.sendPacket(packet);
+            ((EntityPlayer) this.tracker).playerConnection.sendPacket(packet instanceof PacketPlayOutEntityEquipment ? ((PacketPlayOutEntityEquipment) packet).copy() : packet); // PandaSpigot
         }
 
     }
diff --git a/src/main/java/net/minecraft/server/PacketPlayOutEntityEquipment.java b/src/main/java/net/minecraft/server/PacketPlayOutEntityEquipment.java
index aa8f893bc4c7930fbe85028fcf45dcd2866cd982..0fe8920b4cd8d28144bbbcfddee678bca6bff36c 100644
